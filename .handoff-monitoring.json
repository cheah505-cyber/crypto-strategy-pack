{
  "version": 1,
  "max_behind_commits": 50,
  "allowed_author_emails": [
    "github-actions[bot]@users.noreply.github.com"
  ],
  "subject_pattern": "paper trade update [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}",
  "allowed_paths": [
    "data/eth_usdt_4h.csv",
    "paper_trade/equity.csv",
    "paper_trade/state.json",
    "paper_trade/trades.csv"
  ],
  "checks": [
    {
      "name": "GitHub Actions monitoring health",
      "script": "tools/check_monitoring_health.py",
      "args": []
    },
    {
      "name": "paper state consistency",
      "script": "tools/check_monitoring_state.py",
      "args": [
        "--ref",
        "@{upstream}"
      ]
    }
  ]
}
